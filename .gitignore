# Generated files
*.json
!package.json
# ✅ 以下 JSON 属于源码，必须纳入版本控制（原 *.json 规则会把翻译文件一并忽略）
!src/translations/*.json

# 运行时生成的用户配置（记录界面语言，不应入库）
language_config.json

# 工作区/IDE 生成的别名占位文件
folder-alias.json
private-folder-alias.json

# Backup files
*.bak
*.backup
*.old
# exporter 原子写入的临时文件（_write_file_safely）
*.rtg_tmp

# 发布产物：二进制只走 GitHub Releases，绝不入库
*.zip
*.7z
*.tar.gz
Research_Tree_Generator_v*_win64.zip
